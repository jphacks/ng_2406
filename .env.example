# 必須
GEMINI_API_KEY=your_gemini_api_key_here
GAS_ENDPOINT=your_gas_web_app_url_here

# 任意: 使用するGeminiモデル（未設定なら gemini-3.5-flash-lite）
# GEMINI_MODEL=gemini-3.5-flash-lite
# 任意: 無料枠の上限・混雑時に切り替える予備モデル（未設定なら gemini-3.1-flash-lite、空文字で無効）
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# 任意: 日記保存時の改ざん防止署名に使う鍵（未設定なら GEMINI_API_KEY から生成）
# DIARY_SIGNING_SECRET=long_random_string
